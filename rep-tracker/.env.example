# Base URL the frontend calls for API requests (/reps, /member/...).
# Point this at your local Flask backend during development.
# Production Pages builds override it with the PAGES_API_BASE_URL GitHub secret.
VITE_API_BASE_URL=http://localhost:5000

# URL path the built assets are served from (Vite's `base`).
# Keep this as "/" for the custom domain https://howdoesmyrepvote.us.
VITE_PUBLIC_BASE_PATH=/
